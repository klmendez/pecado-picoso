rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pedidos/{pedido} {
      allow create: if true;
      allow read, update, delete: if true;
    }
    match /categorias/{doc} {
      allow read, write: if request.auth != null;
    }
    match /productos/{doc} {
      allow read, write: if request.auth != null;
    }
    match /clientes/{doc} {
      allow read, write: if true;
    }
    match /promociones/{doc} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      // El admin puede editar cualquier campo. Un cliente (sin login) solo
      // puede incrementar en 1 el contador de usos al finalizar un pedido
      // con un cupón aplicado; no puede tocar ningún otro campo.
      allow update: if request.auth != null
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usosActuales'])
          && request.resource.data.usosActuales == resource.data.get('usosActuales', 0) + 1
        );
    }
    match /configuracion/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
